with "target_options.gpr";
with "libgnat_build.gpr";

project Libgnarl_Build is
   for Languages use ("Ada", "Asm_Cpp", "C");

   for Runtime ("Ada") use Libgnat_Build'Runtime("Ada");
   for Target use Libgnat_Build'Target;

   for Library_Auto_Init use "False";
   for Library_Name use "gnarl";
   for Library_Kind use Libgnat_Build'Library_Kind;
   for Library_Options use Libgnat_Build'Library_Options;
   for Library_Version use "libgnarl-" & Target_Options.Version & ".so";

   for Library_Dir use "adalib";
   for Object_Dir use "obj";

   --  for Source_Dirs use ("gnarl_user", "gnarl");
   for Source_Dirs use ("gnarl", "bsp", "bsp/STM32F7xx_HAL_Driver/Src", "bsp/STM32F7xx_HAL_Driver/Inc", 
                       "bsp/CMSIS/Include", "bsp/CMSIS/Device/ST/STM32F7xx/Include", "bsp/conf", 
                       "bsp/BSP/STM32746G-Discovery", "bsp/BSP/Components/Common", "bsp/BSP/Components/ft5336", "bsp/BSP/Components/lis2mdl", 
                       "bsp/BSP/Components/lsm6ds3", "bsp/BSP/Components/lsm6ds3tr-c/driver", "bsp/BSP/Components/lps22df/driver",
                       "bsp/BSP/Components/rk043fn48h", "bsp/BSP/Components/wm8994", "bsp/BSP/Components/n25q128a", 
                       "bsp/BSP/Components/bmp280", "bsp/res", "bsp/wrapper", "bsp/tests", "bsp/hal_stm_lvgl/tft", "bsp/hal_stm_lvgl/touchpad", 
                       "bsp/lvgl/src/lv_core", "bsp/lvgl/src/lv_draw", "bsp/lvgl/src/lv_font", "bsp/lvgl/src/lv_gpu", "bsp/lvgl/src/lv_hal", 
                       "bsp/lvgl/src/lv_misc", "bsp/lvgl/src/lv_themes", "bsp/lvgl/src/lv_widgets");

   package Builder is
      for Switches ("ada") use ("-j10", "-g");
      for Switches ("C") use ("-j10", "-g");
   end Builder;

   package Compiler is
      for Default_Switches ("C") use Target_Options.GNARL_CFLAGS;
      for Default_Switches ("Ada") use Target_Options.GNARL_ADAFLAGS;
      for Default_Switches ("Asm_Cpp") use Target_Options.ASMFLAGS;

      --  Always build System.BB.CPU_Primitives at -O2 as some targets may make
      --  use of inline assembly that rely on specific compiler behaviour to
      --  load constants that are not enabled at -O0.
      for Switches ("s-bbcppr.adb") use Target_Options.GNARL_ADAFLAGS & ("-O2");
      --  Some runtime files need to be compiled with debug info, so that gdb
      --  is not blind.
      for Switches ("s-tasdeb.adb") use Target_Options.ALL_ADAFLAGS
        & ("-g", "-O0");
   end Compiler;

end Libgnarl_Build;
